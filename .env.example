# ===========================================
# ENVIRONMENT BLUEPRINT: Generated via ENV Utility
# Safe to commit into version control
# ===========================================

# --- required ---------------------------------------------------------------
# Host is the central-postgres container name (resolves over proxy_network on the VPS)
DATABASE_URL=your_database_url_here
# Must equal the secret the old server ran with, or every user is logged out once.
JWT_SECRET=your_jwt_secret_here

# --- only for the one-off migration -------------------------------------------
# Atlas connection string. Use a NEW password: the old one is public on GitHub.
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB=your_mongodb_db_here

# --- optional (defaults match the old server) -------------------------------
DB_POOL_SIZE=your_db_pool_size_here
PORT=your_port_here
CORS_ORIGINS=your_cors_origins_here
PUBLIC_WS_URL=your_public_ws_url_here
JWT_EXPIRES_DAYS=your_jwt_expires_days_here
BCRYPT_ROUNDS=your_bcrypt_rounds_here

# --- upgrades -----------------------------------------------------------------
ACTIVITY_LOG_MAX=your_activity_log_max_here
AUTH_RATE_PER_MINUTE=your_auth_rate_per_minute_here
AUTH_FAIL_PER_15MIN=your_auth_fail_per_15min_here
PRESERVE_USER_PROGRAMS=your_preserve_user_programs_here
WS_RATE_PER_SECOND=your_ws_rate_per_second_here
WS_RATE_BURST=your_ws_rate_burst_here
WS_MAX_CODE_LENGTH=your_ws_max_code_length_here
# Turn these on once the frontend sends its JWT on the socket (see README):
WS_REQUIRE_AUTH=your_ws_require_auth_here
WS_ENFORCE_ORIGIN=your_ws_enforce_origin_here

# --- relay (second container, relay/) ----------------------------------------
# It uses the same DATABASE_URL (tables relay_*). Unset DATABASE_URL = no persistence.
RELAY_PORT=your_relay_port_here
RELAY_CONTAINER_NAME=your_relay_container_name_here
RELAY_ALLOWED_ORIGINS=your_relay_allowed_origins_here
RELAY_STATUS_TOKEN=your_relay_status_token_here
RELAY_MAX_CONNECTIONS_PER_IP=your_relay_max_connections_per_ip_here
RELAY_MAX_MESSAGE_BYTES=your_relay_max_message_bytes_here
RELAY_MESSAGE_RETENTION_DAYS=your_relay_message_retention_days_here
RELAY_SENDER_HISTORY_PER_CODE=your_relay_sender_history_per_code_here
RELAY_FAIL_TARPIT_AFTER=your_relay_fail_tarpit_after_here
RELAY_FAIL_PER_IP_10MIN=your_relay_fail_per_ip_10min_here

# Both apps: proxies that append to X-Forwarded-For in front of them (central_nginx = 1)
TRUSTED_PROXY_HOPS=your_trusted_proxy_hops_here

# --- only for migrating the old relay's Mongo data ----------------------------
# RELAY_MONGO_URI=mongodb+srv://USER:PASS@HOST/relay   (or MONGO_USER / MONGO_PASS / MONGO_HOST)